{
  "required": true,
  "minVersion": "0.8",
  "package": "net.quiwh.cwi.mixin.shadow",
  "compatibilityLevel": "JAVA_21",
  "plugin": "net.quiwh.cwi.mixin.shadow.ShadowDropMixinPlugin",
